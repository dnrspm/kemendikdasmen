// Project Management Mock Data

export type TaskStatus = 'pengusulan' | 'belum_dikerjakan' | 'sedang_dikerjakan' | 'perlu_reviu' | 'selesai' | 'diblokir';
export type TaskPriority = 'high' | 'medium' | 'low';
export type ProgramPriority = 'prioritas_presiden' | 'prioritas_nasional' | 'prioritas_kementerian' | 'non_prioritas';
export type EpicStatus = 'belum_dimulai' | 'sedang_dikerjakan' | 'selesai' | 'diblokir' | 'dibatalkan';

// Organizational Hierarchy Types
export interface Biro {
  id: string;
  name: string;
  short_name: string;
  parent_org_id: string; // sekretariat-jenderal
}

export interface TimKerja {
  id: string;
  name: string;
  biro_id: string;
  parent_org_id: string; // sekretariat-jenderal
}

